generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum PreviewStatus {
  unverified
  succeeded
  failed
}

enum PackGenerationStatus {
  queued
  running
  succeeded
  failed
}

enum AssetPartStatus {
  pending
  generating
  completed
  failed
}

enum PlanInterval {
  month
  year
}

enum PlanKey {
  free
  hobby
  pro
}

enum SubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum CancellationReason {
  pricing
  features
  complex
  switch
  other
}

enum CreditLedgerReason {
  monthly_grant
  asset_generation
  refund
  admin_adjustment
}

enum ExternalCleanupTaskStatus {
  pending
  processing
  succeeded
  failed
}

// Core models
model User {
  id          String        @id @default(uuid())
  email       String        @unique
  displayName String?
  workspaces  Workspace[]
  packGenerationJobs PackGenerationJob[]
  subscriptions Subscription[]
  creditLedgerEntries CreditLedger[]
  cancellationFeedbacks SubscriptionCancellationFeedback[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Workspace {
  id                String          @id @default(uuid())
  ownerId           String
  name              String
  thumbnailAssetUri String?
  assetPacks        AssetPack[]
  packGenerationJobs PackGenerationJob[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model AssetPack {
  id                  String      @id @default(uuid())
  workspaceId         String
  displayName         String
  assetUriTs          String?
  editedAssetUriGlb   String?
  packPlan            Json?
  previewStatus       PreviewStatus @default(unverified)
  previewError        String?
  editedAssetUpdatedAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id])
  packGenerationJobs PackGenerationJob[]
  parts      AssetPart[]

  @@index([workspaceId])
}

model AssetPart {
  id           String           @id @default(uuid())
  assetPackId  String
  slug         String
  displayName  String
  description  String?
  prompt       String
  status       AssetPartStatus @default(pending)
  assetUriTs   String?
  errorMessage String?
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assetPack AssetPack @relation(fields: [assetPackId], references: [id], onDelete: Cascade)

  @@unique([assetPackId, slug])
  @@index([assetPackId])
  @@index([status])
}

model PackGenerationJob {
  id               String           @id @default(uuid())
  workspaceId      String
  userId           String
  userPrompt       String
  compiledPrompt   String?
  status           PackGenerationStatus @default(queued)
  message          String?
  title            String?
  assetPackId      String?
  errorMessage     String?
  errorStage       String?
  errorCode        String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id])
  user    User         @relation(fields: [userId], references: [id])
  assetPack AssetPack? @relation(fields: [assetPackId], references: [id])

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([assetPackId])
  @@index([errorStage])
  @@index([errorCode])
}

model Plan {
  id            String       @id @default(uuid())
  key           PlanKey      @unique
  name          String
  stripePriceId String?      @unique
  amount        Int
  currency      String       @default("usd")
  interval      PlanInterval
  intervalCount Int          @default(1)
  isActive      Boolean      @default(true)
  subscriptions Subscription[]
  cancellationFeedbacks SubscriptionCancellationFeedback[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([isActive])
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  planId                 String?
  stripeCustomerId       String
  stripeSubscriptionId   String             @unique
  status                 SubscriptionStatus
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  endedAt                DateTime?
  lastStripeEventCreatedAt  DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])
  plan Plan? @relation(fields: [planId], references: [id])
  cancellationFeedbacks SubscriptionCancellationFeedback[]

  @@index([planId])
  @@index([stripeCustomerId])
  @@index([status])
}

model SubscriptionCancellationFeedback {
  id               String             @id @default(uuid())
  userId           String
  subscriptionId   String
  planId           String?
  reason           CancellationReason?
  details          String?
  cancelAtPeriodEnd Boolean            @default(true)
  status           SubscriptionStatus
  createdAt        DateTime           @default(now())

  user         User         @relation(fields: [userId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  plan         Plan?        @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([planId])
}

model PlanCreditAllowance {
  id                      String   @id @default(uuid())
  planKey                 PlanKey  @unique
  monthlyCredits          Int
  concurrentPackGenerationLimit Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model CreditLedger {
  id              String             @id @default(uuid())
  userId          String
  amount          Int
  reason          CreditLedgerReason
  periodStart     DateTime?
  periodEnd       DateTime?
  relatedAssetPackId String?
  relatedPartId   String?
  idempotencyKey  String             @unique
  createdAt       DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, periodStart])
  @@index([relatedAssetPackId])
  @@index([relatedPartId])
}

model StripeEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  payload       Json
  createdAt     DateTime @default(now())
}

model ExternalCleanupTask {
  id          String                    @id @default(uuid())
  userId      String
  gcsPrefix   String
  status      ExternalCleanupTaskStatus @default(pending)
  attempts    Int                       @default(0)
  maxAttempts Int                       @default(12)
  nextAttemptAt DateTime                @default(now())
  lastError   String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId])
}
