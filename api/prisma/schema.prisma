generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum PreviewStatus {
  unverified
  succeeded
  failed
}

enum DesignStatus {
  queued
  running
  succeeded
  failed
}

enum DesignPartStatus {
  pending
  generating
  completed
  failed
}

enum PlanInterval {
  month
  year
}

enum PlanKey {
  free
  hobby
  pro
}

enum SubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum CancellationReason {
  pricing
  features
  complex
  switch
  other
}

enum ExternalCleanupTaskStatus {
  pending
  processing
  succeeded
  failed
}

// Core models
model User {
  id          String        @id @default(uuid())
  email       String        @unique
  displayName String?
  projects    Project[]
  designJobs DesignJob[]
  subscriptions Subscription[]
  cancellationFeedbacks SubscriptionCancellationFeedback[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Project {
  id         String          @id @default(uuid())
  ownerId    String
  name       String
  designs    Design[]
  designJobs DesignJob[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model Design {
  id                  String      @id @default(uuid())
  projectId           String
  displayName         String
  assetUriTs          String?
  editedAssetUriGlb   String?
  packPlan            Json?
  stageLayout         Json?
  previewStatus       PreviewStatus @default(unverified)
  previewError        String?
  editedAssetUpdatedAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  project    Project     @relation(fields: [projectId], references: [id])
  designJobs DesignJob[]
  parts      DesignPart[]

  @@index([projectId])
}

model DesignPart {
  id           String           @id @default(uuid())
  designId     String
  slug         String
  displayName  String
  description  String?
  prompt       String
  status       DesignPartStatus @default(pending)
  assetUriTs   String?
  errorMessage String?
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, slug])
  @@index([designId])
  @@index([status])
}

model DesignJob {
  id               String           @id @default(uuid())
  projectId        String
  userId           String
  userPrompt       String
  compiledPrompt   String?
  status           DesignStatus @default(queued)
  message          String?
  title            String?
  designId         String?
  errorMessage     String?
  errorStage       String?
  errorCode        String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project Project      @relation(fields: [projectId], references: [id])
  user    User         @relation(fields: [userId], references: [id])
  design Design? @relation(fields: [designId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@index([designId])
  @@index([errorStage])
  @@index([errorCode])
}

model Plan {
  id            String       @id @default(uuid())
  key           PlanKey      @unique
  name          String
  stripePriceId String?      @unique
  amount        Int
  currency      String       @default("usd")
  interval      PlanInterval
  intervalCount Int          @default(1)
  isActive      Boolean      @default(true)
  subscriptions Subscription[]
  cancellationFeedbacks SubscriptionCancellationFeedback[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([isActive])
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  planId                 String?
  stripeCustomerId       String
  stripeSubscriptionId   String             @unique
  status                 SubscriptionStatus
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  endedAt                DateTime?
  lastStripeEventCreatedAt  DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])
  plan Plan? @relation(fields: [planId], references: [id])
  cancellationFeedbacks SubscriptionCancellationFeedback[]

  @@index([planId])
  @@index([stripeCustomerId])
  @@index([status])
}

model SubscriptionCancellationFeedback {
  id               String             @id @default(uuid())
  userId           String
  subscriptionId   String
  planId           String?
  reason           CancellationReason?
  details          String?
  cancelAtPeriodEnd Boolean            @default(true)
  status           SubscriptionStatus
  createdAt        DateTime           @default(now())

  user         User         @relation(fields: [userId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  plan         Plan?        @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([planId])
}

model PlanDesignLimit {
  id                      String   @id @default(uuid())
  planKey                 PlanKey  @unique
  monthlyDesignLimit      Int
  concurrentDesignLimit   Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model StripeEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  payload       Json
  createdAt     DateTime @default(now())
}

model ExternalCleanupTask {
  id          String                    @id @default(uuid())
  userId      String
  gcsPrefix   String
  status      ExternalCleanupTaskStatus @default(pending)
  attempts    Int                       @default(0)
  maxAttempts Int                       @default(12)
  nextAttemptAt DateTime                @default(now())
  lastError   String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId])
}
