{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "orval.config.ts"],
  "exclude": ["node_modules", "dist", "src/typespec/**/*", "src/generated/**/*"],
  "ts-node": {
    "esm": true
  }
}
