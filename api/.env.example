NODE_ENV=development
HOST=0.0.0.0
PORT=3100
GOOGLE_CLOUD_PROJECT=ascoor-dev
FIREBASE_CHECK_REVOKED_ID_TOKENS=false
CHOKIDAR_USEPOLLING=1
CHOKIDAR_INTERVAL=100

DB_HOST=db
DB_PORT=5432
DB_USER=ascoor
DB_PASSWORD=ascoor
DB_NAME=ascoor

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
WEB_APP_BASE_URL=http://localhost:3000

# GCS
USER_FILE_BUCKET=ascoor-dev-user-file
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=.data/storage

# Designs async queue (Cloud Tasks)
PACK_GENERATION_TASKS_GCP_PROJECT_ID=
PACK_GENERATION_TASKS_LOCATION=
PACK_GENERATION_TASKS_QUEUE=
PACK_GENERATION_TASKS_TARGET_BASE_URL=http://localhost:3200
PACK_GENERATION_TASKS_OIDC_SERVICE_ACCOUNT=
PACK_GENERATION_TASKS_OIDC_AUDIENCE=

# Optional overrides (defaults are usually enough)
